# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (for embeddings)
OPENAI_API_KEY=your_openai_api_key

# Anthropic (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags — server-side only. Set to "true" or "1" to enable.
# Anything else (including unset) keeps the feature OFF and its routes 404.
FEATURE_ART=false
FEATURE_CS_AI=false
FEATURE_DEBATE=false
FEATURE_ENRICHMENT=false
FEATURE_FINANCIAL=false
FEATURE_MINDFULNESS=false
FEATURE_PORTFOLIO=false
